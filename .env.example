# FOCUS Online Store - Environment Configuration
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/focus_db

# Authentication
AUTH_SECRET=your-secret-key-here

# Payment Gateway (Ghana-compatible)
PAYMENT_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYMENT_CALLBACK_URL=https://yourdomain.com/api/payment/callback

# WhatsApp Business
WHATSAPP_NUMBER=233000000000

# Email Service
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@focusstore.com

# SMS Service
SMS_API_KEY=your-sms-api-key

# File Storage
STORAGE_BUCKET=focus-uploads

# BMS Integration
BMS_API_URL=https://api.focus-bms.com
BMS_API_KEY=your-bms-api-key

# App
VITE_APP_NAME=FOCUS
VITE_APP_URL=https://focusstore.com
VITE_WHATSAPP_NUMBER=233000000000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
